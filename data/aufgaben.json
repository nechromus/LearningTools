    {"id":"w4t1-u3a","quelle":"W4 Tag 1, Übung 3a","thema":"minus-zahlen","typ":"zahl","stufe":1,"bonus":false,"geschichte":"Emil hat bei seinem Bruder 5 € Schulden. Am Samstag bekommt er 8 € Taschengeld. Er zahlt die Schulden sofort zurück.","frage":"Wie viel Geld hat Emil jetzt?","rechnung":"−5 + 8","antwort":{"wert":3,"einheit":"€"},"hinweise":["euro"],"loesungsweg":["−5 + 8 = 3"],"erklaerung":"5 € zahlt er zurück, 3 € bleiben ihm."},
    {"id":"w4t1-u3c","quelle":"W4 Tag 1, Übung 3c","thema":"minus-zahlen","typ":"zahl","stufe":1,"bonus":false,"geschichte":"Jonas hat 6 € im Portemonnaie. Er kauft ein T-Shirt für 10 €. Sein Freund leiht ihm das Geld, das fehlt.","frage":"Hat Jonas danach Geld oder Schulden? Wie viel?","rechnung":"6 − 10","antwort":{"wert":-4,"einheit":"€"},"hinweise":["euro"],"loesungsweg":["6 − 10 = −4"],"erklaerung":"Es fehlen 4 €. Jonas hat 4 € Schulden."},
    {"id":"w4t2-u4a","quelle":"W4 Tag 2, Übung 4a","thema":"minus-zahlen","typ":"zahl","stufe":2,"bonus":false,"geschichte":"Emir hat 12 € Schulden bei seiner Schwester. Am Wochenende hilft er seinem Onkel im Garten und bekommt dafür 20 €. Er zahlt seine Schulden sofort zurück.","frage":"Wie viel Geld hat Emir danach?","antwort":{"wert":8,"einheit":"€"},"gegeben":[{"name":"Schulden am Anfang","wert":12,"einheit":"€"},{"name":"bekommt","wert":20,"einheit":"€"}],"hinweise":["euro","lang"],"loesungsweg":["−12 + 20 = 8"],"erklaerung":"12 € gehen an die Schwester zurück. Von den 20 € bleiben 8 € übrig."},
    {"id":"w4t2-u4b","quelle":"W4 Tag 2, Übung 4b","thema":"minus-zahlen","typ":"zahl","stufe":2,"bonus":false,"geschichte":"Sara hat 7 € in ihrem Portemonnaie. Im Kino kauft sie Popcorn und ein Getränk. Das kostet zusammen 15 €. Ihre Freundin leiht ihr das Geld, das fehlt.","frage":"Hat Sara danach Geld oder Schulden? Wie viel?","antwort":{"wert":-8,"einheit":"€"},"gegeben":[{"name":"Geld am Anfang","wert":7,"einheit":"€"},{"name":"Popcorn und Getränk kosten","wert":15,"einheit":"€"}],"hinweise":["euro","lang"],"loesungsweg":["7 − 15 = −8"],"erklaerung":"Sara bezahlt mit ihren 7 €. Es fehlen noch 8 €, das sind ihre Schulden."},
    {"id":"w4t2-u4c","quelle":"W4 Tag 2, Übung 4c","thema":"minus-zahlen","typ":"zahl","stufe":2,"bonus":false,"geschichte":"Ben hat schon 9 € Schulden bei seinem Vater. Am Montag leiht er sich noch 6 € für ein Busticket. Am Dienstag leiht er sich 5 € für das Mittagessen.","frage":"Wie hoch sind Bens Schulden jetzt?","antwort":{"wert":-20,"einheit":"€"},"gegeben":[{"name":"Schulden am Anfang","wert":9,"einheit":"€"},{"name":"leiht sich am Montag","wert":6,"einheit":"€"},{"name":"leiht sich am Dienstag","wert":5,"einheit":"€"}],"hinweise":["euro","lang"],"loesungsweg":["−9 − 6 − 5 = −15 − 5 = −20"],"erklaerung":"Die Schulden werden jedes Mal größer: 9, dann 15, dann 20."},
